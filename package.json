{
	"name": "svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "npm@11.19.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run lint",
		"check:fix": "npm run lint:fix && npm run lint:css:fix",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run format:check && eslint . --cache --cache-location node_modules/.cache/eslint/ && npm run lint:css",
		"lint:fix": "npm run format && eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:css:fix": "stylelint \"src/**/*.{css,svelte}\" --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prune": "git fetch --prune",
		"prune:local": "node scripts/git-prune-local.ts",
		"tdd": "vitest",
		"tdd:ui": "vitest --ui",
		"test": "npm run tdd -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"dependencies": {
		"@amadeus-it-group/tansu": "^2.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.5.0",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.62.1",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"@vitest/browser-playwright": "$@vitest/browser-playwright"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}

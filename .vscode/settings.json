{
	"editor.fontSize": 16,
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"prettier.useTabs": true,
	"prettier.tabWidth": 4,
	"prettier.printWidth": 1000,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"git-graph.dialog.merge.noFastForward": false,
	"git-graph.openToTheRepoOfTheActiveTextEditorDocument": true,
	"git.pullBeforeCheckout": true,
	"git-graph.dialog.createBranch.checkOut": true,
	"search.useIgnoreFiles": false,
	"quickConsoleLog.logMessagePrefix": "🔴 (DEBUG) ",
	"quickConsoleLog.quote": "`"
}

const htmlState = {
	htmlBoard: [],
	meilleurCoup: [],
};

function creerCell(cell, noLigne, noCol) {
	let valeur = globalState.board[noLigne][noCol];
	if (valeur === 0) {
		valeur = "";
	}
	if (htmlState.meilleurCoup.length) {
		console.warn("meilleur coup", htmlState.meilleurCoup);
	}
	const couleur = globalState.board[noLigne][noCol] > 0 ? "joueur1" : "joueur2";
	const classPeutJouer = couleur === globalState.trait ? "possible" : "";
	return `<td class="bord-cell" data-id="${noLigne},${noCol}" onclick="clickCase(event)"><div class="billes"></div></td>`;
}
function creerLigne(ligne, noLigne) {
	return `<tr>${ligne.map((cell, noCol) => creerCell(cell, noLigne, noCol)).join('')}</tr>`;
}

function creerTable() {
	const board = globalState.board;
	return `
		<table class="board">
			<tbody>
				${board.map(creerLigne).join('')}
			</tbody>
		</table>
	`;
}
function afficherTable() {
	// console.log("afficherTable", globalState);
	const html = creerTable();
	const boardElement = document.querySelector('#board');
	const htmlBoard = htmlState.htmlBoard;
	boardElement.innerHTML = html;

	const trs = [...boardElement.querySelectorAll("tr")];
	for (let y = 0; y < trs.length; y++)  {
		const ligne = htmlBoard[y] = [];
		const tds = [...trs[y].querySelectorAll("td")];
		for (let x = 0; x < tds.length; x++) {
			ligne.push(tds[x]);
		}
	}
	// console.log('afficherTable, globalState = ', globalState);
}
function majTable() {
	const {board, trait, dernierCoup} = globalState;
	const {htmlBoard} = htmlState;
	// console.log("📢[html.js:44]: trait: ", trait);
	const nbLignes = board.length;
	const nbCols = board[0].length;
	for (let y = 0; y < nbLignes; y++) {
		const ligne = htmlBoard[y];
		for (let x = 0; x < nbCols; x++) {
			let caseClick;
			const td = ligne[x];
			const points = board[y][x];
			const pointsAbs = Math.abs(points);
			couleur = Math.sign(points);
			let classCouleur;
			if (globalState.editeurValide) {
				classCouleur = couleur === 1 ? "joueur1" : couleur === -1 ? "joueur2" : "";
			} else {
				classCouleur = couleur === 1 ? "joueur1" : couleur === -1 ? "joueur2" : "inert";
			}
			let classInactive;
			if (globalState.editeurValide) {
				classInactive = "possible";
			} else {
				classInactive = couleur === trait ? "possible" : "inert";
			}
			if (globalState.dernierCoupValid && dernierCoup.y === y && dernierCoup.x === x) {
				caseClick = "dernierClick";
			} else {
				console.error("globalState.dernierCoupValid", globalState.dernierCoupValid);
			}
			td.className = `bord-cell cell-${pointsAbs} ${classCouleur} ${classInactive} ${caseClick}`;
			const divBilles = td.querySelector('div.billes');
			const divs = [...divBilles.querySelectorAll('div')];
			for (let i = 0; i < pointsAbs; i++) {
				if (!divs[i]) {
					divBilles.appendChild(creerBille(i));
				}
			}
			for (let i = Math.abs(points); i < divs.length; i++) {
				const div = divs[i];
				div.parentNode.removeChild(div);
			}
		}
		if (htmlState.meilleurCoup.length) {
			console.log("Montrer meilleur coup");
			// console.warn("" + htmlState.meilleurCoup[0] + htmlState.meilleurCoup[1]);
			document.querySelector(`[data-id="${htmlState.meilleurCoup[0] + "," + htmlState.meilleurCoup[1]}"]`).classList.add("meilleurCase");
		}
	}

	// console.log("globalState.casesControle.joueur1, globalState.casesControle.joueur2", globalState.casesControle.joueur1, globalState.casesControle.joueur2);
	if (globalState.casesControle.joueur1 && globalState.casesControle.joueur2) {
		console.warn("traitMAP", trait);
		afficherFond(globalState.trait);
	}

}

function legendeCreation([joueur1, joueur2]) {
	document.querySelector(".legende").innerHTML = `
		<div class="joueur1">${joueur1}</div>
		<div class="joueur2">${joueur2}</div>
	`
}

function creerBille(index) {
	const bille = document.createElement("div");
	bille.className = `bille bille-${index + 1}`;
	return bille;
}

function afficherFond(trait) {
	// console.warn("afficherFond", trait);
	trait = trouverTrait(trait);
	document.querySelector(".plateau").className = `plateau ${trait}`;
}
function affichageTrait(trait) {
	const nomJoueurTrait = trait > 0 ? nomsJoueur[0] : nomsJoueur[1];
	const classTrait = trait > 0 ? "joueur1" : "joueur2";
	console.warn("trait", trait);
	document.querySelector(".info").innerHTML = `<h3 class="trait ${classTrait}">Trait à ${nomJoueurTrait}</h3>`;
}
function paramJeu(pageParametre) {
	if (!pageParametre) {
		document.querySelector(".play-container").style.display = "block";
		document.querySelector(".boutons").style.display = "none";
	} else {
		coupsJoues = [];
		nomsJoueur = [];
		document.querySelector("#dialog1").close();
		document.querySelector(".play-container").style.display = "none";
		document.querySelector(".boutons").style.display = "block";
		document.querySelector(".plateau").classList.remove("joueur1", "joueur2");
		document.querySelector(".niveau-ordi").innerHTML = "";
		menuJeu(true);
	}
}

function menuJeu(pageParametre) {
	// console.warn(pageParametre);
	if (!pageParametre) {
		document.querySelector(".menu_content").style.display = "inline-block";
	} else {
		document.querySelector(".menu_content").style.display = "none";
	}
}


function joueurGagnant(gagnant) {
	const nomGagnant = gagnant === "joueur1" ? nomsJoueur[0] : nomsJoueur[1];
	// console.log("joueurGagnant", `<h1 class="vainqueur ${gagnant}">Le gagnant est ${gagnant}</h1>`);
	document.querySelector(".info").innerHTML = `<h1 class="vainqueur ${gagnant}">Le gagnant est ${nomGagnant}</h1>`;
}

let minColor = [0, 238, 255];
let maxColor = [255, 0, 0];
function afficherNiveauDialog() {
	profondeurAnalyse = document.querySelector(".valeur-niveau").innerHTML = document.querySelector(".niveauOrdi").value;
	let color = [];
	for (let i = 0; i < 3; i++) {
		if (minColor < maxColor) {
			color.push(Math.floor(minColor[i] + (maxColor[i] - minColor[i]) * profondeurAnalyse / 10));
		} else {
			color.push(Math.floor(minColor[i] - (maxColor[i] - minColor[i]) * profondeurAnalyse / 10));
		}
	}
	console.warn("couleur", color);
	document.querySelector(".niveauOrdi").style.accentColor = `rgb(${color[0]}, ${color[1]}, ${color[2]})`;
}


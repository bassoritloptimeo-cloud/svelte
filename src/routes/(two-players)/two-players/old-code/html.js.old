function majCalcul(temps, vitesse) {
	let vitesseAff;
	console.log("vitesee", vitesse);
	let unite;
	if (vitesse) {
		if (vitesse < 10000) {
			unite = "Kn/s";
			vitesseAff = `${vitesse.toFixed(1) + " "}`;
		} else {
			vitesse /= 1000;
			vitesseAff = `${vitesse.toFixed(1) + " "}`;
			unite = "Mn/s";
		}
		document.querySelector(".vCalc").innerHTML = `${vitesseAff + unite}`;
	} else {
		document.querySelector(".vCalc").innerHTML = ". . .";
	}
	document.querySelector(`.tCalc`).innerHTML = `${temps}ms`;
}
function afficherInfoCalcul(afficher) {
	if (afficher) {
		document.querySelector(".infoNeg").style.display = "flex";
	} else {
		document.querySelector(".infoNeg").style.display = "none";
	}
}
function validModif(valid) {
	document.querySelector("#dialog_Menu").close();
	if (valid) {
		MAX_WORKERS = document.querySelector(".thread-Select").value;
		const obj = {
			evaluationValid: document.querySelector(".eval-checkbox").checked,
			coupValid: document.querySelector(".mCoup").checked,
			dernierCoupValid: document.querySelector(".dCoup").checked,
			evalEnnemmiValid: document.querySelector(".evalEnnemi").checked,
			negInfo: document.querySelector(".negInfo-checkbox").checked,
		};

		Object.assign(globalState, obj);
		Object.assign(initState, obj);

		if (globalState.evaluationValid) {
			globalState.evaluation = evaluer(globalState);
			afficherEvaluation({name: "evalInstantanee", value: globalState.evaluation, add: true});
		} else {
			afficherEvaluation({name: "evalInstantanee", add: false});
			console.warn("cacher evaluation", globalState.evaluationValid);
			// document.querySelector(".evaluation").innerHTML = "";
		}
		if (!globalState.evalEnnemmiValid) {
			afficherEvaluation({name: "evalAdversaire", add: false});
		}
		if (globalState.coupValid) {
			console.log("nomsJoueur", nomsJoueur);
			profondeurOrdi = profondeurAnalyse;
			profondeurAnalyse = 10;
			nomsJoueursTemporaires = [...nomsJoueur];
			nomsJoueur = globalState.trait === 1 ? [robotName, "joueur1"] : ["joueur2", robotName];
			coupOrdinateur(globalState.trait);
			gererGagnant();
		} else {
			afficherEvaluation({name: "evalAide", add: false});
		}
		afficherInfoCalcul(globalState.negInfo);
		majTable();
	}
}
function validerDialog(e, dialogValid) {
	if (e.key === "Enter") {
		e.preventDefault();
		if (dialogValid === "niveauValid") {
			commencerOrdi();
		} else {
			validModif(false)
		}
	}
}
function editeurCouleur(active) {
	let classRename = "couleurEdition ";
	if (active) {
		classRename += "activeEditeur";
	} else {
		classRename += "desactiveEditeur";
	}
	document.querySelector(".couleurEdition").className = classRename;
}
function pointeur(couleur) {
	document.querySelector(".board").style.cursor = "pointer";
}
function gestionElementEditeur(editeur) {
	if (editeur) {
		document. querySelector(".menu_content").style.display = "none";
		document. querySelector(".fleches").style.display = "none";
		document.querySelector(".valEdit").style.display = "flex";
		document.querySelector(".reinitialiser").style.display = "none";
	} else {
		document. querySelector(".menu_content").style.display = "flex";
		document. querySelector(".fleches").style.display = "flex";
		document.querySelector(".valEdit").style.display = "none";
		document.querySelector(".reinitialiser").style.display = "flex";
	}
}
function traitEdition() {
	if (globalState.editeurValide) {
		console.log("changertrait");
		changerTrait(globalState);
		globalState.editeurTrait = globalState.trait;
		affichageTrait(globalState.trait);
		majTable();
		console.error("globalState.trait", globalState.trait, globalState.editeurTrait);
	}
}

function choisirTrait(traitChoisi) {
	if (traitChoisi) {
		const joueur = traitChoisi === 1 ? "joueur1" : "joueur2";
		document.querySelector(".trait").innerHTML = traitChoisi === 1 ? "vert" : "rouge";
		document.querySelector(".trait").className = `trait ${joueur}`;
		globalState.traitInit = traitChoisi;
	} else {
		document.querySelector(".trait").innerHTML = "aléatoire";
		document.querySelector(".trait").className = `trait alea`;
		globalState.traitInit = undefined;
	}
}
function activateableThreads(thread_MAX) {
	console.warn("thread_MAX", thread_MAX);
	const threadsActive = document.querySelector(".thread-Select");
	threadsActive.value = thread_MAX;
	if (thread_MAX < 8) {
		for (let i = thread_MAX + 2; i <= 16; i += 2) {
			const classSelect = "C" + i;
			document.querySelector(`.${classSelect}`).className = "invalid";
			document.querySelector(`#pet-select option[value="${i}"]`).disabled = true;
		}
	}
}
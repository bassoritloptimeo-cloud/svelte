function afficherEvaluation(type) {
	if (type.add) {
		document.querySelector(`.${type.name}`).style.display = "flex";
		document.querySelector(`.${type.name}-value`).innerHTML = `${Math.round(type.value * 10) / 100}`;
	} else {
		console.log("type.name", type.name);
		console.warn(document.querySelector(`.${type.name}`));
		document.querySelector(`.${type.name}`).style.display = "none";
	}
}

// Calcul ordinateur


async function jeuRobot() {
	const ajouer = globalState.trait === 1 ? nomsJoueur[0] : nomsJoueur[1];
	if (ajouer === robotName) {
		await coupOrdinateur(globalState.trait);
		gererGagnant();
	}
}

function creerNoeud(state) {
	const {board, ...rest} = state;
	const newBoard = [];
	for (let i = 0; i < board.length; i++) {
		const ligne = board[i];
		const newLigne = [];
		newBoard.push(newLigne);
		for (let j = 0; j < ligne.length; j++) {
			newLigne.push(ligne[j]);
		}
	}
	return {board: newBoard, ...structuredClone(rest)};
}


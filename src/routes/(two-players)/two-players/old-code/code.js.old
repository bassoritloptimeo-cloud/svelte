	console.log("📢[code.js:116]: commencerOrdi: ", commencerOrdi);
	profondeurAnalyse = +document.querySelector(".valeur-niveau").textContent;
	const dialog = document.querySelector('#dialog1');
	console.log("📢[code.js:118]: dialog1: ", dialog);
	dialog.close();
	enterValid = true;
	affichageNiveau();
	initGame(true);
}

function vsAmi() {
	// debugger;
	initGame(false);
}

async function explosion(explosions) {
	const exploEnChaine = [];
	for (explo of explosions) {
		let y = explo[0];
		let x = explo[1];
		globalState.board[y][x] = 0;
		// globalState.board[y][x].couleur = undefined;
		const yM = y;
		const xM = x;
		for (const direction of directions) {
			y += direction[0];
			x += direction[1];
			if (globalState.board?.[y]?.[x] !== undefined) {
				if (globalState.board[y][x] >= 3) {
					exploEnChaine.push([y, x]);
				} else {
					globalState.board[y][x] += state.trait;
				}
			}
			y = yM;
			x = xM;
		}
	}
	if (exploEnChaine.length !== 0) {
		await explosion(exploEnChaine);
	} else {
		bilanTerritoire(globalState);
	}
	majTable();
	await pause(delay);
}

function changerTrait(state) {
	state.trait *= -1;
}

function trouverTrait (trait) {
	return trait === 1 ? "joueur1" : "joueur2";
}
function bilanTerritoire(state) {
	state.casesControle.joueur1 = 0;
	state.casesControle.joueur2 = 0;
	for (let i = 0; i < nbRows; i++) {
		for (let j = 0; j < nbCols; j++) {
			const points = state.board[i][j];
			if (points > 0) {
				state.casesControle.joueur1++;
			} else if (points < 0) {
				state.casesControle.joueur2++;
			}
		}
	}
	if (state.casesControle.joueur1 === 0) {
		return "joueur2";
	} else if (state.casesControle.joueur2 === 0) {
		return "joueur1";
	}
}

function gererGagnant() {
	const gagnant = bilanTerritoire(globalState);
	if (gagnant) {
		joueurGagnant(gagnant);
		return true;
	}
	return false;
}

let coupsJoues = [];
async function clickCase(event) {
	const cell = event.currentTarget;
	let coordonnees = cell.dataset['id'].split(',');
	coordonnees = [+coordonnees[0], +coordonnees[1]];
	console.warn("coordonnees", coordonnees);
	if (globalState.editeurValide) {
		ajoutPointEdition({state: globalState, coordonnees});
		majTable();
	} else {
		curseur++;
		if (finDeVariante) {
			console.warn("cordonnées GOOD");
			coupsJoues.push({coordonnees});
		}
		await ajoutPoint({state: globalState, coordonnees, estAsync: true});
		majTable();
	
		if (gererGagnant()) {
			return;
		}
		if (globalState.evaluationValid) {
			globalState.evaluation = evaluer(globalState);
			afficherEvaluation({name: "evalInstantanee", value: globalState.evaluation, add: true});
		}
		if (document.querySelector(".evalAide").style.display = "flex") {
			afficherEvaluation({name: "evalAide", add: false});
		}
		if (!ennemieRobot) {
			afficherInfoCalcul(false);
		}
		changerTrait(globalState);
		affichageTrait(globalState.trait);
		majTable();
		await jeuRobot();
	}
}
async function coupAlphabeta({state, coordonnees, estAsync}) {
	curseur++;
	coupsJoues.push({coordonnees});
	console.log("coupsJoues", coupsJoues);
	await ajoutPoint({state, coordonnees, estAsync});
	if (globalState.evaluationValid) {
		globalState.evaluation = evaluer(globalState);
		afficherEvaluation({name: "evalInstantanee", value: globalState.evaluation, add: true});
	}
}
async function ajoutPoint({state, coordonnees, estAsync}) {
	const {resoudreExplosions} = donnerEvalFns(tabEval, directions);
	let [y, x] = coordonnees;
	const board = state.board;
	const couleur = Math.sign(board[y][x]);
	if (couleur === state.trait) {
		globalState.dernierCoup.y = y;
		globalState.dernierCoup.x = x;
		board[y][x] += couleur;
		let cells = [[y, x]];
		while (cells.length) {
			const explosions = cells.some(([y, x]) => Math.abs(board[y][x]) >= 4);
			// console.log("📢[code.js:235]: explosions: ", explosions);
			if (explosions) {
				if (estAsync) {
					majTable();
					await pause(500);
				}
			}
			const newCells = [];
			for (const cell of cells) {
				newCells.push(...resoudreExplosions(state, cell));
			}
			cells = newCells;
		}
	}
}

function ajoutPointEdition({state, coordonnees}) {
	console.warn("coordonnees", coordonnees);
	let y = coordonnees[0];
	let x = coordonnees[1];
	const board = state.board;
	const couleur = globalState.couleurSelect;
	const couleurActu = Math.sign(board[y][x]);
	if (couleur !== couleurActu) {
		board[y][x] = couleur;
	} else if (board[y][x] < 3 && board[y][x] > -3) {
		board[y][x] += couleur;
	} else {
		board[y][x] = 0;
	}
}

document.addEventListener("keydown", function (event) {
	if (event.code === "ArrowLeft") {
    	moveCurseur(-1);
  	} else if (event.code === "ArrowRight") {
    	moveCurseur(1);
  	}
});

let curseur = 0;
let finDeVariante = true;
function moveCurseur(avance) {
	// debugger;
	console.log("coupsJoues", coupsJoues);
	console.log("avance", avance);
	curseur += avance;
	if (curseur !== coupsJoues.length) {
		finDeVariante = false;
	} else {
		finDeVariante = true;
	}
	console.log("fin de variante", finDeVariante);
	if (curseur < 0) {
		curseur = 0;
		globalState = initState;
		console.warn("initState", initState);
		majTable();
	} else if (curseur > coupsJoues.length) {
		curseur = coupsJoues.length;
	} else {
		let trait = curseur % 2 === 0 ? initState.trait : initState.trait * -1;
		afficherFond(trait);
		if (curseur - 1 >= 0 && globalState.evalEnnemmiValid) {
			const evaluation = coupsJoues[curseur - 1].eval;
			console.error("evaluationMEM", coupsJoues, curseur - 1, evaluation);
			if (evaluation) {
				afficherEvaluation({name: "evalAdversaire", value: evaluation, add: true});
			}
		}
		// changerTrait(globalState);
	}
	globalState = structuredClone(initState);
	const {ajoutPointMinmax} = donnerEvalFns(tabEval, directions);
	console.log("initState", initState);
	if (curseur => 0 || curseur < coupsJoues.length - 1) {
		for (let i = 0; i < curseur; i++) {
			console.log("curseur modif", curseur, coupsJoues.length, i);
			globalState.dernierCoup.y = coupsJoues[i].coordonnees[0];
			globalState.dernierCoup.x = coupsJoues[i].coordonnees[1];
			ajoutPointMinmax({state: globalState, coordonnees: coupsJoues[i].coordonnees});
			changerTrait(globalState);
		}
		majTable();
	}
}

function evalMemoire(evaluation) {
	// debugger;
	console.warn("curseur", curseur);
	coupsJoues[curseur - 1].eval = evaluation;
	console.log("coupsJoues", coupsJoues);
}

function ajout(couleur) {
	globalState.couleurSelect = couleur;
	pointeur(couleur);
}

function validEdition() {
	globalState.boardEdition = structuredClone(globalState.board);
	document.querySelector(".editeur-checkbox").checked = false;
	globalState.editeurTrait = globalState.trait;
	console.log("valid édition");
	initGame(jeuOrdi);
}

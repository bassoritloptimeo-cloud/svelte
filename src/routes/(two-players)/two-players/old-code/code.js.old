let tabEval = [];

function preCalculs(tailleGrille) {
	const milieu = (tailleGrille - 1) / 2;
	const BASE_VALUE_OFFSET = 0.75;
	const ROUNDING_FACTOR = 10;
	const centerValue = Math.round(BASE_VALUE_OFFSET + Math.sqrt(2 * Math.pow(milieu, 2)) * ROUNDING_FACTOR);
	let evals = [];
	for (let i = 0; i < tailleGrille; i++) {
		const distI = Math.abs(milieu - i);
		let lineEval = [];
		for (let j = 0; j < tailleGrille; j++) {
			const distJ = Math.abs(milieu - j);
			console.log("i", i, "j", j, "distI", distI, "distJ", distJ);
			lineEval.push(Math.round((centerValue - Math.sqrt(Math.pow(distI, 2) + Math.pow(distJ, 2))) * ROUNDING_FACTOR) / ROUNDING_FACTOR);
		}
		evals.push(lineEval);
	}
	console.warn(evals);
	return evals;
}


async function coupOrdinateur(trait) {
	const {donnerEnfants, jouer} = donnerEvalFns(tabEval, directions);
	await pause(100);
	console.warn("profondeurAnalyse", profondeurAnalyse);
	const ajouer = globalState.trait === 1 ? nomsJoueur[0] : nomsJoueur[1];
	calculdebut = new Date();
	const stateForComputer = creerNoeud(globalState);
	const casesPossibles = donnerEnfants(stateForComputer);
	if (casesPossibles) {
		console.log("📢[code.js:639]: nomsJoueur[0]: ", nomsJoueur[0]);
		let meilleurCase = await trouverMeilleurCoup(stateForComputer, profondeurAnalyse, nomsJoueur[0] === robotName);
		const tempsDeCalcul = new Date() - calculdebut;
		if (globalState.negInfo && tempsDeCalcul) {
			majCalcul(tempsDeCalcul, globalState.nbClone / tempsDeCalcul);
		} else {
			majCalcul(tempsDeCalcul);
		}
		globalState.nbClone = 0;
		if (!globalState.coupValid) {
			await pause(750 - tempsDeCalcul);
			console.warn("Temps total avec pause : ", new Date() - calculdebut, "ms");
			await coupAlphabeta({state: globalState, coordonnees: meilleurCase, estAsync: true});
			changerTrait(globalState);
			affichageTrait(globalState.trait);
		} else {
			globalState.coupValid = false;
			profondeurAnalyse = profondeurOrdi;
			nomsJoueur = nomsJoueursTemporaires;
			htmlState.meilleurCoup = [...meilleurCase];
		}
		majTable();
		htmlState.meilleurCoup = [];
	}
}

let MAX_WORKERS = (navigator.hardwareConcurrency);
function createPoolWorker() {
    // Détection du nombre de cœurs disponibles (par défaut 4)
    
    // sconst MAX_WORKERS = 1;
    const poolWorkers = [];
    
    // On crée les Workers au démarrage
    for (let i = 0; i < MAX_WORKERS - 1; i++) {
        poolWorkers.push(new Worker('./worker.js'));
    }
	return {
		poolWorkers,
		destroy() {
			poolWorkers.forEach(worker => worker.terminate());
		}
	};
}


// Fonction utilitaire pour distribuer les tâches aux Workers disponibles
function gererCalculParallele(workers, taches) {
    console.log("📢[code.js:600]: gererCalculParallele: ");
    return new Promise((resolve) => {
        const resultatsFinaux = [];
        let indexTache = 0;
        let tachesTerminees = 0;

        if (taches.length === 0) resolve([]);

        function lancerTacheSurWorker(worker) {
            console.log("📢[code.js:609]: lancerTacheSurWorker: ");
            // S'il n'y a plus de tâches dans la file d'attente, on arrête
            if (indexTache >= taches.length) return;

            const idActuel = indexTache++;
            const tacheActuelle = taches[idActuel];

            // On configure la réception du résultat pour ce Worker
            worker.onmessage = function(evenement) {
				const {type, evaluation, n} = evenement.data;
				globalState.nbClone += n;
				if (type === 'RESULTAT') {
					console.log("📢[code.js:616]: coup trouvé: ", tacheActuelle.coup, evenement.data.evaluation);
                    resultatsFinaux.push({ 
                        coup: tacheActuelle.coup, 
                        evaluation: evaluation,
						n,
                    });
                    tachesTerminees++;

                    if (tachesTerminees === taches.length) {
                        // Toutes les branches ont été calculées !
                        resolve(resultatsFinaux);
                    } else {
                        // Le worker est libre, on lui donne la tâche suivante
                        lancerTacheSurWorker(worker);
                    }
                }
            };

            // On envoie la tâche au Worker
            worker.postMessage({ type: 'CALCULER', donnees: tacheActuelle });
        }

        // Au départ, on lance tous nos workers disponibles sur les premières tâches
        workers.forEach(worker => lancerTacheSurWorker(worker));
    });
}

async function trouverMeilleurCoup(noeud, profondeur, estJoueurMaximisant) {
	console.error("estJoueurMaximisant", estJoueurMaximisant);
	const {donnerEnfants, jouer} = donnerEvalFns(tabEval, directions);
	const coups = donnerEnfants(noeud);
	
	// 1. On prépare la liste des tâches (les branches du premier niveau)
	const listeTaches = coups.map(coup => {
		const noeudEnfant = jouer(noeud, coup);
		return {
			coup,
			noeudEnfant,
			tabEval,
			directions,
			profondeur: profondeur - 1,
			alpha: -Infinity,
			beta: Infinity,
			prochainJoueurMax: !estJoueurMaximisant
		};
	});

	// 2. On distribue ces tâches à nos Workers en parallèle et on attend (await)
	const {poolWorkers, destroy} = createPoolWorker();
	const resultats = await gererCalculParallele(poolWorkers, listeTaches);
	console.log("📢[code.js:663]: destroy: ");
	destroy();

	// 3. On analyse les résultats pour choisir le meilleur coup
	let meilleurCoup = undefined;
	let meilleureEvaluation = estJoueurMaximisant ? -Infinity : +Infinity;

	for (const res of resultats) {
		const { coup, evaluation } = res;
		console.log("Évaluation reçue pour le coup :", coup, "-> Score :", evaluation);

		if (
			(!estJoueurMaximisant && evaluation < meilleureEvaluation) ||
			(estJoueurMaximisant && evaluation > meilleureEvaluation)) {
				meilleureEvaluation = evaluation;
				meilleurCoup = coup;
		}
	}

	console.log("Recherche parallèle terminée. Meilleur coup :", meilleurCoup);
	const ajouer = globalState.trait === 1 ? nomsJoueur[0] : nomsJoueur[1];
	if (globalState.evalEnnemmiValid && ajouer === robotName) {
		afficherEvaluation({name: "evalAdversaire", value: meilleureEvaluation, add: true});
		evalMemoire(meilleureEvaluation);
	}
	if (globalState.coupValid && globalState.evaluationValid) {
		afficherEvaluation({name: "evalAide", value: meilleureEvaluation, add: true});
	}

	
	// (Garde ici tes fonctions de mise à jour de globalState et d'affichage)
	
	return meilleurCoup;
}





// A changer

function evaluer(stateForComputer) {
	let {board} = stateForComputer;
	let evaluation = 0;
	let nombreCasesPossiblesJoueur1 = 0;
	let nombreCasesPossiblesJoueur2 = 0;
	const tailleJ = board.length;
	for (let j = 0; j < tailleJ; j++) {
		const ligne = board[j];
		const tailleI = ligne.length;
		for (let i = 0; i < tailleI; i++) {
			const cell = ligne[i];
			evaluation += cell * tabEval[i][j];
			if (cell > 0) {
				nombreCasesPossiblesJoueur1++;
			} else if (cell < 0) {
				nombreCasesPossiblesJoueur2++;
			}
		}
	}
	
	if (!nombreCasesPossiblesJoueur1) {
		return -MAX_EVAL;
	} else if (!nombreCasesPossiblesJoueur2) {
		return MAX_EVAL;
	}
	// nbEvaluation++;
	return evaluation;
}
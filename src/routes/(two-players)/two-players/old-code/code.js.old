const select = document.getElementById('pet-select');
let selectedValue;
let jeuOrdi = false;
const robotName = "Robot";
let enterValid = true;
select.addEventListener('change', () => {
  	selectedValue = select.options[select.selectedIndex].value;
	console.log('Valeur sélectionnée :', selectedValue);
});
let ennemieRobot;
// const delay = 500;
let nbRows = 5;
let nbCols = 5;
let profondeurOrdi = 1;
let profondeurAnalyse = 1;
let calculdebut;
const directions = [
	[1, 0],
	[0, 1],
	[-1, 0],
	[0, -1]
];
console.log("navigator.hardwareConcurrency", navigator.hardwareConcurrency);
let globalState = {
	board: [],
	trait: undefined, // 1 -> vert, -1 -> rouge
	traitInit: undefined,
	dernierCoup: {y: undefined, x: undefined},
	casesControle: {joueur1: 1, joueur2: 1},
	evaluationValid: false,
	evaluation: undefined,
	evalEnnemmiValid: undefined,
	coupValid: false,
	editeurValide: false,
	dernierCoupValid: false,
	couleurSelect: 0,
	boardEdition: undefined,
	editeurTrait: 0,
	negInfo: false,
	nbClone: 0,
};
let nomsJoueur;
let nomsJoueursTemporaires;

document.addEventListener("DOMContentLoaded", () => {
	activateableThreads(navigator.hardwareConcurrency);
});

function pause(ms) {
	const promise = new Promise(function(resolve) {
		setTimeout(function() {
			resolve();
        }, ms);
    });
    return promise;
}
let initState;
function placement(couleur, board, premPlace = [-2, -2]) {
	if (!globalState.boardEdition) {
		let cell = [...premPlace];
		while (Math.abs(cell[0] - premPlace[0]) < 2 && Math.abs(cell[1] - premPlace[1]) < 2) {
			cell = [Math.floor(Math.random() * nbRows), Math.floor(Math.random() * nbCols)];
		}
		if (couleur === "joueur1") {
			board[cell[0]][cell[1]] = 3;
		} else {
			board[cell[0]][cell[1]] = -3;
		}
		return cell;
	}
}
function initGame(contreOrdi) {
	curseur = 0;
	console.error("globalState.editeurTrait", globalState.editeurTrait);
	globalState.editeurValide = document.querySelector(".editeur-checkbox").checked;
	jeuOrdi = contreOrdi;
	finDeVariante = true;
	coupsJoues = [];
	globalState.dernierCoup = {y: undefined, x: undefined};
	globalState.dernierCoupValid = document.querySelector(".dCoup").checked;
	// console.clear();
	if (selectedValue !== undefined) {
		nbRows = selectedValue;
		nbCols = selectedValue;
	}
	if (!contreOrdi) {
		ennemieRobot = false;
		nomsJoueur = [document.querySelector(".nom-joueur1").value, document.querySelector(".nom-joueur2").value];
		if (nomsJoueur[0] === "" || nomsJoueur[1] === "") {
			nomsJoueur = ["joueur1", "joueur2"];
		}
	} else {
		ennemieRobot = true;
		if (document.querySelector(".nom-joueur1").value) {
			nomsJoueur = [document.querySelector(".nom-joueur1").value, robotName];
		} else if (document.querySelector(".nom-joueur2").value) {
			nomsJoueur = [robotName, document.querySelector(".nom-joueur2").value];
		} else {
			nomsJoueur = ["joueur1", robotName];
		}
		console.log("nbRows", nbRows);
	}
	tabEval = preCalculs(nbRows);
	console.log("globalState", globalState);
	globalState.board = [];
	globalState.casesControle.joueur1 = 1;
	globalState.casesControle.joueur2 = 1;
	const board = globalState.board;
	console.error("globalState.traitInit", globalState.traitInit);
	if (!globalState.traitInit) {
		globalState.trait = Math.random() < 0.5 ? 1 : -1;
	} else {
		globalState.trait = globalState.traitInit;
	}
	console.log("trait", globalState.trait);
	if (globalState.boardEdition) {
		console.warn("globalState.boardEdition", globalState.boardEdition);
		globalState.board = structuredClone(globalState.boardEdition);
		globalState.trait = globalState.editeurTrait;
	} else {
		for (let i = 0; i < nbRows; i++) {
			const ligne = [];
			board.push(ligne);
			for (let j = 0; j < nbCols; j++) {
				ligne.push(0);
			}
		}
	}
	const joueurs = Math.random() < 0.5 ? ["joueur1", "joueur2"] : ["joueur2", "joueur1"];
	/*
	if (contreOrdi) {
		creerTest();
		}
		*/
		paramJeu(false);
		menuJeu(false);
		legendeCreation(nomsJoueur);
	if (!globalState.editeurValide) {
		const cell = placement(joueurs[0], board);
		placement(joueurs[1], board, cell);
		afficherTable();
		majTable();
		if (!globalState.boardEdition) {
			affichageTrait(globalState.trait);
		} else {
			globalState.trait = globalState.editeurTrait;
		}
		initState = structuredClone(globalState);
		jeuRobot();
		editeurCouleur(false);
		gestionElementEditeur(false);
	} else {
		afficherTable();
		majTable();
		affichageTrait(globalState.trait);
		editeurCouleur(true);
		gestionElementEditeur(true);
	}
	globalState.boardEdition = undefined;
}
function recommencerJeu() {
	console.warn("ennemieRobot =", ennemieRobot);
	initGame(ennemieRobot);
}
